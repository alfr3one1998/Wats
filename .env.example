# محليًا فقط: إن لم تضع كلمة مرور فسيستخدم التطبيق admin123.
# في الإنتاج يجب تعيين كلمة مرور قوية وسر جلسة طويل وعشوائي.
NODE_ENV=development
PORT=3000
ADMIN_PASSWORD=ضع-كلمة-مرور-قوية-هنا
COOKIE_SECRET=ضع-هنا-نصًا-عشوائيًا-طويلًا-لا-يقل-عن-32-حرفًا

# اتركه كما هو في التطوير. عند الاستضافة مع قرص دائم استخدم مثلًا /data/wats.sqlite
DATA_PATH=./data/wats.sqlite

# إعدادات WhatsApp Business Platform / Meta
WHATSAPP_VERIFY_TOKEN=اختر-رمز-تحقق-سري-خاص-بك
WHATSAPP_APP_SECRET=ضع-App-Secret-من-Meta-هنا

# فعّلها فقط إذا كانت الاستضافة تمرر HTTPS من خلال proxy.
TRUST_PROXY=false
SECURE_COOKIES=false

# زر الرسالة التجريبية يظهر محليًا فقط. اجعله false في النشر.
ENABLE_DEMO=true
